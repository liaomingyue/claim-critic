<View>
  <Header value="参考文献（[被引用] 是 claim 标注的出处，[对照] 是同组未被引用的文献）"/>
  <Text name="refs" value="$refs_text"/>
  <Header value="术语表"/>
  <Text name="glossary" value="$glossary_text"/>
  <Header value="待判定 claim"/>
  <Text name="claim" value="$claim"/>
  <Header value="claim 标注的引用"/>
  <Text name="cited" value="$cited_text"/>

  <Header value="1. 判定"/>
  <Choices name="verdict" toName="claim" choice="single" required="true">
    <Choice value="faithful"/>
    <Choice value="hallucination"/>
  </Choices>

  <View visibleWhen="choice-selected" whenTagName="verdict" whenChoiceValue="hallucination">
    <Header value="2. 错误类型（只选一类，按标注规范 3 节的顺序判断）"/>
    <Choices name="type" toName="claim" choice="single" required="true">
      <Choice value="citation_error" hint="引用错误：挂错出处 / 无中生有"/>
      <Choice value="term_error" hint="术语翻译错误"/>
      <Choice value="wrong_attribution" hint="张冠李戴"/>
      <Choice value="unsupported_inference" hint="不合理推理"/>
      <Choice value="missing_condition" hint="前提缺失"/>
    </Choices>
    <Header value="错误原因（一句话）"/>
    <TextArea name="reason" toName="claim" rows="2" maxSubmissions="1"/>
  </View>

  <Header value="3. 证据：选 ref 编号，并从参考文献中逐字复制片段（引用错误且哪篇都没有出处时不填）"/>
  <Choices name="evidence_ref" toName="refs" choice="single">
    <Choice value="ref-1"/><Choice value="ref-2"/><Choice value="ref-3"/><Choice value="ref-4"/>
    <Choice value="ref-5"/><Choice value="ref-6"/><Choice value="ref-7"/><Choice value="ref-8"/>
  </Choices>
  <TextArea name="evidence_text" toName="refs" rows="3" maxSubmissions="1"/>
</View>
